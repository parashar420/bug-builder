# ─── Athena API Configuration ─────────────────────────────────────────────────
# API key is stored in athena_token.txt (NOT here)
# See athena_token.txt.example for instructions
# Rename this file to .env (remove the .example suffix)

ATHENA_BASE_URL=https://athena.webmdhelios.com/v1
ATHENA_MODEL=saas-openai-gpt-4.1
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_OPT_OUT=true